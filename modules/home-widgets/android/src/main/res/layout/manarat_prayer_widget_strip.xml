<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"
  android:background="@drawable/manarat_widget_light" android:padding="6dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
    <TextView android:id="@+id/prayer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="22sp" android:textStyle="bold" android:textColor="#19382B" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/prayer_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="#536F5F" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/prayer_timer_group" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end" android:orientation="vertical" android:paddingStart="8dp">
    <Chronometer android:id="@+id/prayer_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:countDown="true" android:textSize="24sp" android:textStyle="bold" android:textColor="#19382B" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/prayer_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="#536F5F" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
</LinearLayout>
