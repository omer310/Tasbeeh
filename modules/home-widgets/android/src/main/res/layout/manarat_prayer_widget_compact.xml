<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/manarat_prayer_light" android:gravity="center_vertical">
  <TextView android:id="@+id/prayer_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"  />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:id="@+id/prayer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
    <TextView android:id="@+id/prayer_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
    <Chronometer android:id="@+id/prayer_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:countDown="true" android:textSize="26sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/prayer_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
  </LinearLayout>
  <TextView android:id="@+id/prayer_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"  />
</LinearLayout>
